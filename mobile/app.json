{
  "expo": {
    "name": "Healthbar",
    "slug": "Healthbar",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.healthbar.app"
    },
    "scheme": "healthbar",
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-web-browser",
      "expo-dev-client",
      "expo-image-picker",
      "expo-camera",
      ["@stripe/stripe-react-native", { "merchantIdentifier": "merchant.com.healthbar.app" }]
    ]
  }
}
