// NutriApp — Prisma Schema
// Convention: snake_case for all DB fields; camelCase in application code via Prisma mapping.

generator client {
  provider      = "prisma-client-js"
  // Include musl (Alpine) targets for Docker; "native" covers macOS dev
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  ACTIVE
  VERY_ACTIVE
}

enum Goal {
  LOSE_WEIGHT
  MAINTAIN
  GAIN_MUSCLE
}

enum FoodSource {
  USDA
  OPEN_FOOD_FACTS
  CUSTOM
}

enum MealTime {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id             String        @id @default(cuid())
  email          String        @unique
  password_hash  String
  name           String
  age            Int
  weight_kg      Float
  height_cm      Float
  gender         Gender
  activity_level ActivityLevel
  goal           Goal
  created_at     DateTime      @default(now())
  updated_at     DateTime      @updatedAt

  meals      Meal[]
  daily_logs DailyLog[]

  @@map("users")
}

model Food {
  id                      String     @id @default(cuid())
  name                    String
  brand                   String?
  // All nutritional values stored per 100g — multiply by (quantity_g / 100) for actual values
  calories_per_100g       Float
  proteins_per_100g       Float
  carbs_per_100g          Float
  fats_per_100g           Float
  fiber_per_100g          Float
  // Extended metrics — populated for processed foods; null for whole foods
  sugar_per_100g          Float?
  saturated_fats_per_100g Float?
  salt_per_100g           Float?
  source                  FoodSource
  external_id             String? // e.g. Open Food Facts barcode
  created_at              DateTime   @default(now())

  meal_foods MealFood[]

  @@map("foods")
}

model Meal {
  id          String   @id @default(cuid())
  // null user_id = global template (read-only for users)
  user_id     String?
  name        String
  is_template Boolean  @default(false)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  user            User?          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  meal_foods      MealFood[]
  daily_log_meals DailyLogMeal[]

  @@map("meals")
}

/// Junction table linking foods to meals with portion size.
model MealFood {
  id         String @id @default(cuid())
  meal_id    String
  food_id    String
  quantity_g Float // Portion size in grams

  meal Meal @relation(fields: [meal_id], references: [id], onDelete: Cascade)
  food Food @relation(fields: [food_id], references: [id])

  @@map("meal_foods")
}

/// Stores daily nutritional targets as a snapshot at creation time.
/// IMPORTANT: target_* fields must NEVER be recalculated from User retroactively.
/// If the user changes their goals, new DailyLogs get new targets; old ones remain intact.
model DailyLog {
  id              String   @id @default(cuid())
  user_id         String
  date            DateTime @db.Date
  // Snapshot of targets at log creation — decoupled from current User goals
  target_calories Float
  target_proteins Float
  target_carbs    Float
  target_fats     Float
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  user            User           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  daily_log_meals DailyLogMeal[]

  // One log per user per day
  @@unique([user_id, date])
  @@map("daily_logs")
}

/// Records a meal being consumed at a specific time within a daily log.
model DailyLogMeal {
  id           String   @id @default(cuid())
  daily_log_id String
  meal_id      String
  meal_time    MealTime
  logged_at    DateTime @default(now())

  daily_log DailyLog @relation(fields: [daily_log_id], references: [id], onDelete: Cascade)
  meal      Meal     @relation(fields: [meal_id], references: [id])

  @@map("daily_log_meals")
}
