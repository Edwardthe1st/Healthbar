# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=nutriapp
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=nutriapp

# Full connection URL (used by Prisma and the API)
DATABASE_URL=postgresql://nutriapp:change_me_in_production@postgres:5432/nutriapp

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET=replace_with_a_random_64_byte_hex_string
JWT_REFRESH_SECRET=replace_with_a_different_random_64_byte_hex_string

# ─── Services ─────────────────────────────────────────────────────────────────
ML_SERVICE_URL=http://ml-service:8001
PORT=3000

# ─── CORS (optional) ──────────────────────────────────────────────────────────
# CORS_ORIGIN=*

# ─── pgAdmin (dev only) ───────────────────────────────────────────────────────
PGADMIN_EMAIL=admin@nutriapp.local
PGADMIN_PASSWORD=admin
